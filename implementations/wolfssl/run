#!/bin/sh
# Adapter entry point; the binary is built by build.sh.
bin="$(dirname "$0")/../../.build/wolfssl/bin/wolfssl-adapter"
if [ ! -x "$bin" ]; then
    echo "wolfssl adapter not built; run implementations/wolfssl/build.sh" >&2
    echo '{"event": "result", "ok": false, "version": null, "group": null, "hrr": null, "hrr_cookie": null, "hrr_group": null, "error": "adapter not built"}'
    exit 1
fi
exec "$bin" "$@"
