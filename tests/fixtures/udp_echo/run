#!/usr/bin/env python3
"""Test-only adapter: the shim contract over plain UDP or TCP (no DTLS/TLS), with injectable
misbehaviour. With --transport=tls it relays over TCP; --tls-hello sends a synthetic
CH1/HRR/CH2 in TLS records first, so the runner's trace analysis sees real TCP flows."""

import argparse
import json
import os
import re
import signal
import socket
import subprocess
import sys
import threading

EXIT_USAGE = 64
BEHAVIOURS = (
    "normal",
    "never-ready",
    "ready-no-port",
    "hang",
    "exit2",
    "garbage",
    "bad-result",
    "crash",
    "fail",
    "exit2-on-ping",
)
ROLE_OPTIONS = {
    "client": {"key_share"},
    "server": {"validate", "cert", "key"},
}
COMMON_OPTIONS = {"variant", "transport", "resume", "host", "port", "groups", "mtu", "ca"}
RECV_TIMEOUT = 30.0


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.exit(EXIT_USAGE, f"{self.prog}: usage error: {message}\n")


class Once(argparse.Action):
    """Store an option that may appear only once."""

    def __call__(self, parser, namespace, values, option_string=None):
        if getattr(namespace, self.dest) is not None:
            parser.error(f"{option_string} given more than once")
        setattr(namespace, self.dest, values)


def role_variants(path, role):
    """Variant names usable in `role` according to a `ROLE NAME: description` file."""
    if path is None or not os.path.isfile(path):
        return set()
    names = set()
    with open(path) as f:
        for line in f:
            words = line.partition(":")[0].split()
            if len(words) == 2 and words[0] in (role, "both"):
                names.add(words[1])
    return names


def name(value):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", value):
        raise argparse.ArgumentTypeError(f"invalid name {value!r}")
    return value


def mtu(value):
    if value == "default":
        return value
    if not value.isdigit() or int(value) < 576:
        raise argparse.ArgumentTypeError(f"invalid mtu {value!r}")
    return int(value)


def report(value):
    key, sep, raw = value.partition("=")
    if not sep:
        raise argparse.ArgumentTypeError(f"expected KEY=JSON, got {value!r}")
    return key, json.loads(raw)


def parse_args(parser):
    parser.add_argument("--role", action=Once, choices=("client", "server"))
    parser.add_argument("--variant", action=Once, type=name)
    parser.add_argument("--transport", action=Once, choices=("dtls", "tls"))
    parser.add_argument("--resume", action=Once, choices=("off", "ticket"))
    parser.add_argument("--host", action=Once)
    parser.add_argument("--port", action=Once, type=int)
    parser.add_argument("--groups", action=Once)
    parser.add_argument("--mtu", action=Once, type=mtu)
    parser.add_argument("--ca", action=Once)
    parser.add_argument("--key-share", action=Once)
    parser.add_argument("--validate", action=Once, choices=("off", "cookie"))
    parser.add_argument("--cert", action=Once)
    parser.add_argument("--key", action=Once)
    # Test-only switches, appended by the wrappers the tests install.
    parser.add_argument("--variants-file", action=Once)
    parser.add_argument("--behave", choices=BEHAVIOURS, default="normal")
    parser.add_argument("--spawn-child", action="store_true", help="leave a long-lived grandchild")
    parser.add_argument("--report", type=report, action="append", default=[], help="KEY=JSON")
    parser.add_argument("--implements", default="dtls,tls", help="transports; others exit 2")
    parser.add_argument("--tls-hello", choices=("echo", "drop", "alter"), help="client CH2 cookie")
    args = parser.parse_args()
    if args.role is None:
        parser.error("--role is required")
    other = "server" if args.role == "client" else "client"
    for opt in sorted(COMMON_OPTIONS | ROLE_OPTIONS[args.role]):
        if getattr(args, opt) is None:
            parser.error(f"--{opt.replace('_', '-')} is required for {args.role}")
    for opt in sorted(ROLE_OPTIONS[other]):
        if getattr(args, opt) is not None:
            parser.error(f"--{opt.replace('_', '-')} is a {other} option")
    if args.variant != "default" and args.variant not in role_variants(
        args.variants_file, args.role
    ):
        parser.error(f"--variant={args.variant} is not a {args.role} variant")
    if args.transport == "tls" and args.mtu != "default":
        parser.error("--mtu must be default with --transport=tls")
    share = args.key_share
    if share not in (None, "empty", "default") and share not in args.groups.split(","):
        parser.error(f"--key-share={share} is not in --groups")
    return args


def emit(obj):
    print(json.dumps(obj), flush=True)


def result(args, ok, error=None, connection=1):
    fields = {"version": None, "group": None, "hrr": None, "hrr_cookie": None, "hrr_group": None}
    fields["resumed"] = connection == 2 if ok else None
    fields.update(args.report)
    if error is not None and args.resume == "ticket":
        error = f"connection {connection}: {error}"
    emit({"event": "result", "ok": ok, **fields, "error": error})


# Synthetic TLS handshake messages (RFC 9846 sec 4.2.2, 4.2.4) carrying only a cookie extension.
HRR_RANDOM = bytes.fromhex("cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c")
COOKIE = b"echo-fixture-cookie"


def tls_record(msg_type, body):
    hs = bytes([msg_type]) + len(body).to_bytes(3) + body
    return b"\x16\x03\x03" + len(hs).to_bytes(2) + hs


def cookie_ext(cookie):
    if cookie is None:
        return b""
    data = len(cookie).to_bytes(2) + cookie
    return (44).to_bytes(2) + len(data).to_bytes(2) + data


def client_hello(cookie):
    exts = cookie_ext(cookie)
    body = b"\x03\x03" + bytes(32) + b"\x00" + b"\x00\x02\x13\x01" + b"\x01\x00"
    return tls_record(1, body + len(exts).to_bytes(2) + exts)


def hello_retry_request():
    exts = cookie_ext(COOKIE)
    body = b"\x03\x03" + HRR_RANDOM + b"\x00" + b"\x13\x01\x00"
    return tls_record(2, body + len(exts).to_bytes(2) + exts)


def recv_exactly(conn, n):
    data = b""
    while len(data) < n:
        chunk = conn.recv(n - len(data))
        if not chunk:
            raise ConnectionError("connection closed early")
        data += chunk
    return data


def recv_record(conn):
    header = recv_exactly(conn, 5)
    return header + recv_exactly(conn, int.from_bytes(header[3:5]))


class Unsupported(Exception):
    """Exit 2 with this error."""


def hang():
    threading.Event().wait()


def exchange(args, conn, peer=None):
    """One connection's ping/pong; returns the error, or None."""
    if args.role == "server":
        if args.transport == "tls":
            if args.tls_hello:
                recv_record(conn)
                conn.sendall(hello_retry_request())
                recv_record(conn)
            data = recv_exactly(conn, 4)
        else:
            data, peer = conn.recvfrom(2048)
        if args.behave == "crash":
            os.kill(os.getpid(), signal.SIGKILL)
        if args.behave == "exit2-on-ping":
            raise Unsupported("unsupported, found out during the handshake")
        if data != b"ping":
            return f"unexpected payload {data!r}"
        if args.transport == "tls":
            conn.sendall(b"pong")
        else:
            conn.sendto(b"pong", peer)
        return None
    if args.transport == "tls" and args.tls_hello:
        conn.sendall(client_hello(None))
        recv_record(conn)
        echoed = {"echo": COOKIE, "drop": None, "alter": COOKIE[::-1]}[args.tls_hello]
        conn.sendall(client_hello(echoed))
    if args.transport == "tls":
        conn.sendall(b"ping")
        data = recv_exactly(conn, 4)
    else:
        conn.send(b"ping")
        data = conn.recv(2048)
    if args.behave == "crash":
        os.kill(os.getpid(), signal.SIGKILL)
    if data != b"pong":
        return f"unexpected payload {data!r}"
    return None


def main():
    args = parse_args(Parser())
    print(f"pid={os.getpid()} variant={args.variant}", file=sys.stderr, flush=True)
    if args.spawn_child:
        child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(3600)"])
        print(f"child-pid={child.pid}", file=sys.stderr, flush=True)

    if args.behave == "exit2":
        result(args, False, f"{args.role}: configuration not supported")
        return 2
    if args.transport not in args.implements.split(","):
        result(args, False, f"{args.transport} transport not implemented")
        return 2
    if args.behave == "garbage":
        print("this is not JSON", flush=True)

    kind = socket.SOCK_STREAM if args.transport == "tls" else socket.SOCK_DGRAM
    connections = 2 if args.resume == "ticket" else 1
    sock = None
    if args.role == "server":
        sock = socket.socket(socket.AF_INET, kind)
        sock.settimeout(RECV_TIMEOUT)
        sock.bind((args.host, args.port))
        if args.transport == "tls":
            sock.listen()
        if args.behave == "never-ready":
            hang()
        if args.behave == "ready-no-port":
            emit({"event": "ready"})
            hang()
        emit({"event": "ready", "port": sock.getsockname()[1]})
        if args.behave == "hang":
            hang()
    elif args.behave == "hang":
        hang()
    for n in range(1, connections + 1):
        # The client opens a new socket per connection, so connection 2 has a new source port.
        if args.role == "server" and args.transport == "tls":
            conn, _ = sock.accept()
            conn.settimeout(RECV_TIMEOUT)
        elif args.role == "server":
            conn = sock
        else:
            conn = socket.socket(socket.AF_INET, kind)
            conn.settimeout(RECV_TIMEOUT)
            conn.connect((args.host, args.port))
        try:
            error = exchange(args, conn)
        except Unsupported as e:
            result(args, False, str(e), n)
            return 2
        if conn is not sock:
            conn.close()
        if error is not None:
            result(args, False, error, n)
            return 1

    if args.behave == "fail":
        result(args, False, "simulated handshake failure", connections)
        return 1
    if args.behave == "bad-result":
        emit({"event": "result", "ok": True})
        return 0
    result(args, True, connection=connections)
    return 0


if __name__ == "__main__":
    sys.exit(main())
